# Contact form delivery.
#
# Without RESEND_API_KEY the endpoint still validates and returns 200, but it
# does NOT deliver — so a visitor is never told an enquiry arrived when it
# did not. Set the key before going live.
#
# 1. Create a free account and API key at https://resend.com/api-keys
# 2. Verify the sending domain (or use onboarding@resend.dev while testing)
# 3. Add the key in Vercel: Settings -> Environment Variables -> RESEND_API_KEY

RESEND_API_KEY=

# Inbox that receives enquiries. Defaults to office@next360.in.
CONTACT_TO=

# Verified sender. Use your own domain once verified, e.g.
# "Next360 <website@next360.in>"
CONTACT_FROM=