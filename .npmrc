; npm install fails with ERESOLVE because several plugins declare
; conservative peer ranges that stop at ^9, even though they run
; correctly on ESLint 10:
;   eslint-plugin-jsx-a11y  peer eslint ^3..^9    -> 34 rules verified OK on 10
;   eslint-plugin-react     peer eslint ..^9.7    -> rules verified OK on 10
;   typescript-eslint       peer typescript <6.1 -> only pulled in by
;                            eslint-config-next, which is why this project
;                            requires Next's compiled Babel parser directly
; Verified on eslint 10.11.0 / typescript 7.0.2: lint, tsc, build all pass.
; Remove once upstream peer ranges widen.
legacy-peer-deps=true
